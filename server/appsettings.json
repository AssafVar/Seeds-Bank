{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // "*" accepts any Host header: set AllowedHosts to the real host name(s) in each deployment.
  // Outside Development the app refuses to start unless ForwardedHeaders:Enabled is set explicitly (true only behind
  // the platform proxy, which is needed for HTTPS/HSTS and per-IP rate limits) and AllowedHosts is not "*"
  // (or Hosting:AllowAnyHost=true is set on purpose).
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "seeds-bank",
    "Audience": "seeds-bank-client",
    "Key": "",
    "ExpiresMinutes": 120
  },
  // Private S3-compatible bucket (Cloudflare R2 in production). PublicOrigin is where browsers load files from:
  // the R2 endpoint origin, e.g. https://<account>.r2.cloudflarestorage.com. Region is "auto" for R2.
  "Storage": {
    "ServiceUrl": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "PublicOrigin": ""
  },
  // SMTP (Resend in production: smtp.resend.com, port 587, user "resend", the API key as password).
  // An empty Host turns email off: queued emails are dropped with a warning.
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "User": "",
    "Password": "",
    "From": "",
    "FromName": "Seeds-Bank"
  },
  "Pedigree": {
    "MaxPlantsPerProject": 20000,
    "MaxLinesPerProject": 500,
    "MaxPopulationsPerLine": 200,
    "MaxAncestorDepth": 1000,
    "MaxAncestorNodes": 50000
  },
  "LoginThrottle": {
    "MaxFailures": 5,
    "WindowMinutes": 15,
    "BackoffSeconds": 60,
    "MaxTrackedAccounts": 10000
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "SignupPermitLimit": 5,
    "SignupWindowSeconds": 3600
  }
}
