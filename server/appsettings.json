{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // "*" accepts any Host header: set AllowedHosts to the real host name(s) in each deployment.
  // Set ForwardedHeaders:Enabled=true only behind the platform proxy (needed for HTTPS/HSTS and per-IP rate limits).
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "seeds-bank",
    "Audience": "seeds-bank-client",
    "Key": "",
    "ExpiresMinutes": 120
  },
  "Pedigree": {
    "MaxPlantsPerProject": 20000,
    "MaxLinesPerProject": 500,
    "MaxPopulationsPerLine": 200,
    "MaxAncestorDepth": 1000,
    "MaxAncestorNodes": 50000
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "SignupPermitLimit": 5,
    "SignupWindowSeconds": 3600
  }
}
