{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // "*" accepts any Host header: set AllowedHosts to the real host name(s) in each deployment.
  // Outside Development the app refuses to start unless ForwardedHeaders:Enabled is set explicitly (true only behind
  // the platform proxy, which is needed for HTTPS/HSTS and per-IP rate limits) and AllowedHosts is not "*"
  // (or Hosting:AllowAnyHost=true is set on purpose).
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "seeds-bank",
    "Audience": "seeds-bank-client",
    "Key": "",
    "ExpiresMinutes": 120
  },
  "Pedigree": {
    "MaxPlantsPerProject": 20000,
    "MaxLinesPerProject": 500,
    "MaxPopulationsPerLine": 200,
    "MaxAncestorDepth": 1000,
    "MaxAncestorNodes": 50000
  },
  "LoginThrottle": {
    "MaxFailures": 5,
    "WindowMinutes": 15,
    "BackoffSeconds": 60,
    "MaxTrackedAccounts": 10000
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "SignupPermitLimit": 5,
    "SignupWindowSeconds": 3600
  }
}
